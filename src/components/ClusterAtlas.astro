---
// The cluster atlas: every cluster region on one flat map, drawn as SVG at
// build time, with a pin for each cluster's upcoming events. No script. Two
// drawings share one set of outlines: a wide one with every cluster named
// beside the map (each name leads to its card), and a narrow one for phones
// with short codes. A legend and a table give the same information as text.
import { STATUS_LABELS, shortDate, type Cluster, type ClusterEvent, type RankedRegion } from '../lib/clusters';
import { KM_PER_UNIT, atlasFrame, graticule, labelPoint, labelSide, project, rampLabel, rampStep, regionPath, shortCode, spreadLabels } from '../lib/cluster-atlas';

interface Props {
  /** Regions in drawing order: larger first, so smaller areas sit on top. */
  regions: RankedRegion[];
  clusters: Cluster[];
  /** Upcoming events, soonest first. */
  events: ClusterEvent[];
  asOf: string;
}
const { regions, clusters, events, asOf } = Astro.props;
const byId = new Map(clusters.map((c) => [c.id, c]));
const counts = new Map<string, number>();
const next = new Map<string, ClusterEvent>();
for (const e of events) {
  counts.set(e.cluster, (counts.get(e.cluster) ?? 0) + 1);
  if (!next.has(e.cluster)) next.set(e.cluster, e);
}
const most = Math.max(0, ...counts.values());
const frame = atlasFrame(regions);
const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const dayMonth = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short' });

const items = regions.map((f) => {
  const c = byId.get(f.properties.id);
  const n = counts.get(f.properties.id) ?? 0;
  const live = c ? c.status === 'live' : true;
  const [x, y] = labelPoint(frame, f);
  const upcoming = next.get(f.properties.id);
  return {
    id: f.properties.id,
    name: c?.name ?? f.properties.name,
        live,
    status: c ? STATUS_LABELS[c.status] : 'Live',
    region: c?.region ?? '',
    n,
    step: rampStep(n, most),
    x,
    y,
    side: labelSide(f.properties.lon, f.properties.lat),
    next: upcoming?.date ?? null,
    note: !live ? (c ? STATUS_LABELS[c.status] : '') : n ? `${count(n, 'event', 'events')} · next ${dayMonth(upcoming!.date)}` : 'No events listed',
  };
});
const pinned = items.filter((i) => i.n > 0);
const liveCount = items.filter((i) => i.live).length;
const summary = `Map of the UK's ${items.length} regional defence and security cluster areas. ${
  pinned.length ? `${count(pinned.length, 'cluster has', 'clusters have')} upcoming events: ${pinned.map((i) => `${i.name} ${i.n}`).join(', ')}.` : 'No cluster has upcoming events listed.'
} The table after the map gives the same information.`;

// The wide drawing: the map in the middle, names down each side.
const W = { width: 960, height: 800, mapX: 250, mapY: 22, mapW: 460, mapH: 756, left: 226, right: 734 };
const wk = Math.min(W.mapW / frame.width, W.mapH / frame.height);
const wx = W.mapX + (W.mapW - frame.width * wk) / 2;
const wy = W.mapY + (W.mapH - frame.height * wk) / 2;
const at = (k: number, ox: number, oy: number, x: number, y: number): [number, number] => [ox + x * k, oy + y * k];
const callouts = (['left', 'right'] as const).flatMap((side) =>
  spreadLabels(
    items.filter((i) => i.side === side).map((i) => ({ ...i, px: at(wk, wx, wy, i.x, i.y)[0], y: at(wk, wx, wy, i.x, i.y)[1] })),
    44,
    W.height - 34,
    46,
  ),
);
const grid = graticule(frame, 2);
const lonX = (k: number, ox: number, lon: number) => ox + project(frame, lon, 0)[0] * k;
const latY = (k: number, oy: number, lat: number) => oy + project(frame, 0, lat)[1] * k;
const degrees = (v: number, positive: string, negative: string) => (v === 0 ? '0°' : `${Math.abs(v)}°${v > 0 ? positive : negative}`);
const r = (v: number) => Math.round(v * 10) / 10;
const scaleKm = 100;
const titleLines = ['UK regional defence', 'and security clusters', `${liveCount} live · ${items.length - liveCount} not yet live`, `As of ${shortDate(asOf)}`];

// The narrow drawing: the map alone, with short codes.
const N = { width: 360, pad: 8 };
const nk = (N.width - N.pad * 2) / frame.width;
const nHeight = Math.ceil(frame.height * nk + N.pad * 2);
---
<figure class="atlas" id="cluster-map">
  <svg class="atlas-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="atlas-hatch" width="22" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect class="atlas-hatch-ground" width="22" height="22" />
        <line class="atlas-hatch-line" x1="0" y1="0" x2="0" y2="22" />
      </pattern>
      <pattern id="atlas-hatch-small" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect class="atlas-hatch-ground" width="5" height="5" />
        <line class="atlas-hatch-line atlas-hatch-fine" x1="0" y1="0" x2="0" y2="5" />
      </pattern>
      {regions.map((f) => <path id={`atlas-r-${f.properties.id}`} class="atlas-shape" d={regionPath(frame, f)} />)}
    </defs>
  </svg>

  <svg class="atlas-map atlas-wide" viewBox={`0 0 ${W.width} ${W.height}`} role="group" aria-label={summary}>
    <g class="atlas-grid" aria-hidden="true">
      {grid.lons.map((lon) => <line x1={r(lonX(wk, wx, lon))} y1="0" x2={r(lonX(wk, wx, lon))} y2={W.height} />)}
      {grid.lats.map((lat) => <line x1="0" y1={r(latY(wk, wy, lat))} x2={W.width} y2={r(latY(wk, wy, lat))} />)}
      {grid.lons.filter((lon) => lonX(wk, wx, lon) > W.mapX - 20 && lonX(wk, wx, lon) < W.mapX + W.mapW + 20).map((lon) => (
        <text class="atlas-degree" x={r(lonX(wk, wx, lon) + 4)} y={W.height - 6}>{degrees(lon, 'E', 'W')}</text>
      ))}
      {grid.lats.filter((lat) => latY(wk, wy, lat) > 20 && latY(wk, wy, lat) < W.height - 20).map((lat) => (
        <text class="atlas-degree" x="4" y={r(latY(wk, wy, lat) - 5)}>{degrees(lat, 'N', 'S')}</text>
      ))}
    </g>
    <g class="atlas-title" aria-hidden="true">
      <rect class="atlas-title-ground" x="40" y="22" width="196" height="126" />
      {titleLines.map((line, i) => <text class:list={['atlas-mono', { 'atlas-title-head': i < 2 }]} x="48" y={40 + i * 16 + (i > 1 ? 8 : 0)}>{line}</text>)}
      <path class="atlas-scale" d={`M48 ${136}v-6h${r((scaleKm / KM_PER_UNIT) * wk)}v6`} />
      <text class="atlas-mono" x={r(48 + (scaleKm / KM_PER_UNIT) * wk + 8)} y="137">{scaleKm} km</text>
    </g>
    <g class="atlas-shadow" transform={`translate(${r(wx + 6)} ${r(wy + 6)}) scale(${wk.toFixed(5)})`} aria-hidden="true">
      {regions.map((f) => <use href={`#atlas-r-${f.properties.id}`} />)}
    </g>
    <g class="atlas-land" transform={`translate(${r(wx)} ${r(wy)}) scale(${wk.toFixed(5)})`} aria-hidden="true">
      {items.map((i) => (
        <use href={`#atlas-r-${i.id}`} class:list={['atlas-region', i.live ? `r${i.step}` : 'is-pending']} fill={i.live ? undefined : 'url(#atlas-hatch)'} data-region={i.id} data-live={String(i.live)} />
      ))}
    </g>
    {callouts.map((c) => {
      const left = c.side === 'left';
      const edge = left ? W.left : W.right;
      const elbow = left ? edge + 22 : edge - 22;
      const tx = left ? edge - 4 : edge + 4;
      return (
        <g class="atlas-callout">
          <a class="atlas-label" href={`#c-${c.id}`}>
            <rect class="atlas-hit" x={left ? 40 : edge - 2} y={r(c.labelY - 20)} width={left ? edge - 38 : W.width - edge - 6} height="40" />
            <text class="atlas-name" x={tx} y={r(c.labelY - 2)} text-anchor={left ? 'end' : 'start'}>{c.name}</text>
            <text class:list={['atlas-mono', 'atlas-note', { 'has-events': c.n > 0 && c.live }]} x={tx} y={r(c.labelY + 13)} text-anchor={left ? 'end' : 'start'}>{c.note}</text>
          </a>
          <g aria-hidden="true">
            <path class="atlas-leader" d={`M${edge + (left ? 4 : -4)} ${r(c.labelY)}H${elbow}L${r(c.px)} ${r(c.y)}`} />
            {c.n > 0 ? (
              <g class="atlas-pin" transform={`translate(${r(c.px)} ${r(c.y)})`}>
                <rect class="atlas-pin-shadow" x="-8" y="-8" width="22" height="22" />
                <rect class="atlas-pin-box" x="-11" y="-11" width="22" height="22" />
                <text class="atlas-pin-count" y="4.5" text-anchor="middle" data-pin={c.id}>{c.n}</text>
              </g>
            ) : (
              <rect class="atlas-dot" x={r(c.px - 3)} y={r(c.y - 3)} width="6" height="6" />
            )}
          </g>
        </g>
      );
    })}
  </svg>

  <svg class="atlas-map atlas-narrow" viewBox={`0 0 ${N.width} ${nHeight}`} role="img" aria-label={summary}>
    <g class="atlas-grid">
      {grid.lons.map((lon) => <line x1={r(lonX(nk, N.pad, lon))} y1="0" x2={r(lonX(nk, N.pad, lon))} y2={nHeight} />)}
      {grid.lats.map((lat) => <line x1="0" y1={r(latY(nk, N.pad, lat))} x2={N.width} y2={r(latY(nk, N.pad, lat))} />)}
    </g>
    <g class="atlas-title">
      <rect class="atlas-title-ground" x="0" y="6" width="150" height="62" />
      {titleLines.slice(2).map((line, i) => <text class="atlas-mono" x="8" y={20 + i * 14}>{line}</text>)}
      <path class="atlas-scale" d={`M8 ${60}v-5h${r((scaleKm / KM_PER_UNIT) * nk)}v5`} />
      <text class="atlas-mono" x={r(8 + (scaleKm / KM_PER_UNIT) * nk + 6)} y="61">{scaleKm} km</text>
    </g>
    <g class="atlas-shadow" transform={`translate(${N.pad + 4} ${N.pad + 4}) scale(${nk.toFixed(5)})`}>
      {regions.map((f) => <use href={`#atlas-r-${f.properties.id}`} />)}
    </g>
    <g class="atlas-land" transform={`translate(${N.pad} ${N.pad}) scale(${nk.toFixed(5)})`}>
      {items.map((i) => (
        <use href={`#atlas-r-${i.id}`} class:list={['atlas-region', i.live ? `r${i.step}` : 'is-pending']} fill={i.live ? undefined : 'url(#atlas-hatch)'} data-region={i.id} data-live={String(i.live)} />
      ))}
    </g>
    {items.map((i) => {
      const [x, y] = at(nk, N.pad, N.pad, i.x, i.y);
      return i.n > 0 ? (
        <g transform={`translate(${r(x)} ${r(y)})`}>
          <g class="atlas-pin">
            <rect class="atlas-pin-shadow" x="-6.5" y="-6.5" width="18" height="18" />
            <rect class="atlas-pin-box" x="-9" y="-9" width="18" height="18" />
            <text class="atlas-pin-count" y="4" text-anchor="middle" data-pin={i.id}>{i.n}</text>
          </g>
          <text class="atlas-code" y="21" text-anchor="middle">{shortCode(i.id)}</text>
        </g>
      ) : (
        <text class="atlas-code" x={r(x)} y={r(y + 3.5)} text-anchor="middle">{shortCode(i.id)}</text>
      );
    })}
  </svg>

  <figcaption>
    <div class="atlas-legend">
      <div class="legend-group">
        <span class="mono">Upcoming events</span>
        <ul class="legend-ramp">
          <li><svg class="legend-swatch" viewBox="0 0 26 14" aria-hidden="true" focusable="false"><rect class="atlas-region r0" x="1" y="1" width="24" height="12" /></svg>None</li>
          {[1, 2, 3, 4].map((step) => (
            <li><svg class="legend-swatch" viewBox="0 0 26 14" aria-hidden="true" focusable="false"><rect class:list={['atlas-region', `r${step}`]} x="1" y="1" width="24" height="12" /></svg>{rampLabel(step, most)}</li>
          ))}
        </ul>
      </div>
      <div class="legend-group">
        <svg class="legend-swatch legend-pin" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><rect class="atlas-pin-box" x="1" y="1" width="20" height="20" /><text class="atlas-pin-count" x="11" y="15.5" text-anchor="middle">2</text></svg>
        <span>A cluster's upcoming events, pinned to its area</span>
      </div>
      <div class="legend-group">
        <svg class="legend-swatch" viewBox="0 0 26 14" aria-hidden="true" focusable="false"><rect class="atlas-region is-pending" fill="url(#atlas-hatch-small)" x="1" y="1" width="24" height="12" /></svg>
        <span>Not yet live</span>
      </div>
    </div>
    <details class="atlas-table">
      <summary>The map as a table</summary>
      <div class="table-scroll" role="region" aria-label="Clusters on the map, table" tabindex="0">
        <table>
          <caption>Clusters on the map</caption>
          <thead>
            <tr><th scope="col">Cluster</th><th scope="col">Map code</th><th scope="col">Area</th><th scope="col">Status</th><th scope="col">Upcoming events</th><th scope="col">Next event</th></tr>
          </thead>
          <tbody>
            {[...items].sort((a, b) => a.name.localeCompare(b.name, 'en-GB')).map((i) => (
              <tr>
                <th scope="row"><a href={`#c-${i.id}`}>{i.name}</a></th>
                <td class="mono">{shortCode(i.id)}</td>
                <td>{i.region}</td>
                <td>{i.status}</td>
                <td class="num">{i.n}</td>
                <td>{i.next ? shortDate(i.next) : 'None listed'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </figcaption>
</figure>

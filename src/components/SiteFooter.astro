---
// The footer on every page: the page's own credit lines (the slot), then the
// same links everywhere, including Get listed, and the built-by line.
import { getListedMailto } from '../lib/contact';
import { NAV } from '../lib/nav';
---
<footer class="site-footer">
  {Astro.slots.has('default') && <div class="footer-credits"><slot /></div>}
  <nav aria-label="Footer">
    <ul class="footer-links">
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href="/ask-tally">Use Tally in your AI assistant</a></li>
      <li><a href={getListedMailto()}>Get listed</a></li>
    </ul>
  </nav>
  <p class="footer-built">Built by <a href="https://milux.co.uk">MilUX</a> using AI-assisted engineering. <a href="/about">How Tally is built.</a></p>
</footer>

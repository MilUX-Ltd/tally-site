---
import '../styles/base.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { NavId } from '../lib/nav';
import { canonicalUrl } from '../lib/company-page';
import { FEED_PATH } from '../lib/new-companies';
import { beaconConfig } from '../lib/analytics';
interface Props {
  title: string;
  description: string;
  wide?: boolean;
  /** Whether the page has a canonical address (not the 404 page). */
  canonical?: boolean;
  /** Whether to advertise the new companies feed in the head. */
  feed?: boolean;
  /** The navigation item to mark as current; worked out from the address when left out. */
  current?: NavId | null;
  /** Whether the page loads the visitor counter. False on the script-free pages (D-z6mw4). */
  counted?: boolean;
  /** Whether search engines are asked to leave the page out (a closed company's page). */
  noindex?: boolean;
}
const { title, description, wide = false, canonical = true, feed = false, current, counted = true, noindex = false } = Astro.props;
// Slots: the default slot is the page; "actions" sits at the right of the top
// bar (the shortlist button); "credits" is the page's own data credit lines
// at the top of the footer.
// Canonical addresses are on tally.milux.co.uk and end in a slash, as served.
const beacon = counted ? beaconConfig() : null;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonicalUrl(path)} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-800.woff2" as="font" type="font/woff2" crossorigin />
    {feed && <link rel="alternate" type="application/rss+xml" title="New companies in Tally" href={FEED_PATH} />}
    {beacon && <script is:inline defer src="/scripts/cf-beacon.js" data-cf-beacon={beacon}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current}><slot name="actions" /></SiteHeader>
    <main id="main" class:list={{ wide }}>
      <slot />
    </main>
    {Astro.slots.has('credits') ? <SiteFooter><slot name="credits" /></SiteFooter> : <SiteFooter />}
  </body>
</html>

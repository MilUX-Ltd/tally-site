---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getListedMailto } from '../lib/contact';
---
<Base title="Tally: UK defence capability" description="An open map and directory of UK defence capability. Public information, free to use." wide>
  <header class="site-header">
    <h1>Tally</h1>
    <p>An open map and directory of UK defence capability. Public information, free to use. Choose capabilities and other filters to see where companies are, then select an area of the map to list them. Company missing? <a href={getListedMailto()}>Get listed</a>.</p>
  </header>
  <div id="explorer">
    <p class="notice">Loading companies.</p>
    <noscript><p>The map and filters need JavaScript. The full directory is also on <a href="https://github.com/MilUX-Ltd/tally">GitHub</a>.</p></noscript>
  </div>
  <SiteFooter>
    <p>Company data: <a href="https://github.com/MilUX-Ltd/tally">the Tally directory</a>, from public sources, under CC BY 4.0.</p>
  </SiteFooter>
</Base>
<script>
  import '../scripts/explorer';
</script>

---
import Base from '../layouts/Base.astro';
---
<Base title="Tally: find UK defence companies by capability and place" description="Find UK defence companies by capability and place on an open map, shortlist the ones you want and share the list. Public sources, free to use." wide feed>
  <button slot="actions" type="button" class="topbar-button" id="shortlist-toggle" aria-pressed="false">Shortlist <span class="count" id="shortlist-count">0</span></button>
  <div id="explorer">
    <div class="find landing">
      <div class="lead hero">
        <p class="mono kicker">Open directory · public sources · free to use</p>
        <h1 class="display">Find UK defence capability<span class="stop">.</span></h1>
        <p class="lede">Companies, clusters and defence sites on one map. Search by capability and place, shortlist the companies you want and share the list.</p>
        <p class="moved">Loading companies.</p>
        <noscript><p class="moved">The map and search need JavaScript. Every company also has its own page, listed in the <a href="/sitemap.xml">sitemap</a>, and the full directory is on <a href="https://github.com/MilUX-Ltd/tally">GitHub</a>.</p></noscript>
      </div>
      <div class="fade" aria-hidden="true"></div>
    </div>
  </div>
  <Fragment slot="credits">
    <p>Company data: <a href="https://github.com/MilUX-Ltd/tally">the Tally directory</a>, from public sources, under CC BY 4.0.</p>
  </Fragment>
</Base>
<script>
  import '../scripts/explorer';
</script>

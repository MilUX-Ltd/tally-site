// Cloudflare Workers static assets (docs/adr/0001). Deploys run from CI only.
// The custom domain is bound at go-live; until then the workers.dev URL is the
// preview and verification surface.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}

// Cloudflare Workers static assets (docs/adr/0001) with one Worker route,
// /api/search (docs/adr/0004). Pages and data are served straight from
// assets; only /api/* runs the Worker. Deploys run from CI only.
// The custom domain is bound at go-live; until then the workers.dev URL is the
// preview and verification surface.
//
// The search key is the Worker secret ANTHROPIC_API_KEY, never in this file.
// Without it, search answers {"fallback": true} and the browser runs a keyword
// search. Pull-request previews (wrangler preview) never receive the key.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SEARCH_DAILY_BUDGET": "300"
  },
  "ratelimits": [
    { "name": "SEARCH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SEARCH_BUDGET", "class_name": "SearchBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SearchBudget"] }],
  // Worker Previews do not inherit the top-level vars and bindings; each
  // preview gets its own Durable Object namespace.
  "previews": {
    "vars": {
      "SEARCH_DAILY_BUDGET": "300"
    },
    "ratelimits": [
      { "name": "SEARCH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
    ],
    "durable_objects": {
      "bindings": [{ "name": "SEARCH_BUDGET", "class_name": "SearchBudget" }]
    }
  }
}
